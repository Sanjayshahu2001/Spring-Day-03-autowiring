<?xml version="1.0" encoding="UTF-8"?>

<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:p="http://www.springframework.org/schema/p"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <bean id="obj" class="model.Student">
        <property name="name" value="Sanjay"/>
        <property name="Roll" value="850"/>
        <property name="Add" ref="Add"/>
        
    </bean>

    <bean id="Add" class="model.Addresh">
        <property name="Ploat_no" value="101"/>
        <property name="Area" value="Ghatate Nagar"/>
        <property name="City" value="Nagpur"/>
    </bean>

</beans>
